<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Both hardware features are optional so a tablet lacking one is not
        excluded from the other: a USB-only tablet still programs over a cable,
        a Bluetooth-only one still reaches a UV-5R Mini.
    -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!--
        Classic Bluetooth, declared only to say it is not required either.

        Asking for BLUETOOTH and BLUETOOTH_ADMIN below makes Android imply
        `android.hardware.bluetooth`, and an implied feature is required
        unless something says otherwise - so the built app told Play it needed
        Bluetooth hardware, and Play would have hidden it from anything
        without a radio. The line above covers BLE and is a different feature
        name, so it did not help. Seen in `aapt2 dump badging` on a release
        build as `uses-implied-feature`, not in this file.
    -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!--
        And location hardware, for the same reason and from the same cause.
        The two legacy location permissions below are capped at API 30, but
        `aapt2` implies `android.hardware.location` from their presence at
        all, and an implied feature is required unless it is contradicted -
        so a device with no location hardware would have been told this radio
        programmer was not for it. boofwang never asks where you are.
    -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!--
        `allowBackup` is off, because the privacy policy says these bytes do
        not leave the device and Android Auto Backup would make that untrue.

        With no extraction rules the default backup set is shared prefs plus
        the app's files and databases, and that includes the WebView profile
        directory where this app's IndexedDB lives - which is the backups
        store, so a DM-32UV image with its 22 AES key slots in it. Google's
        copy is encrypted with the device lock-screen secret, so this was
        never a plaintext disclosure. It was still a copy off the device that
        survives an uninstall, which is exactly what app/pages/privacy.vue
        tells people does not happen.

        The copy is the promise, so the flag moved rather than the words.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Offer boofwang when a programming cable is plugged in. Choosing
                it in the system dialogue also grants USB permission for that
                device, which is the one path that never needs a second prompt.
                The filter lists the four USB-serial vendors the drivers
                recognise; test/app/mobile-config.spec.ts holds it to that table.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Bluetooth. From Android 12 the two runtime permissions below are the
        whole story. `neverForLocation` says the scan is not used to infer
        position, which is true, and it must agree with the
        `androidNeverForLocation` flag the plugin is initialised with in
        app/mobile/bluetooth.ts - when the two disagree, Android 12+ returns
        no scan results and says nothing.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 and below, where a scan needed the legacy pair and a location grant. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!--
        Declared here only to put a ceiling on it. The Bluetooth plugin's own
        manifest asks for coarse location with no `maxSdkVersion`, and a
        library permission the app does not also declare comes through the
        merger exactly as the library wrote it - so the built app asked for
        approximate location on every Android version, while the line above
        carefully stopped at 11 and `neverForLocation` said the scan was not
        about position. Checked in the built bundle, not inferred: `aapt2 dump
        badging` on the release APK listed ACCESS_COARSE_LOCATION with no
        ceiling, and a Play listing would have shown "approximate location"
        for a radio programmer that never asks where you are.

        30 is the right ceiling and not a guess. BluetoothLe.kt's `initialize`
        requests the two location aliases only on the pre-S branch; from
        Android 12 with `androidNeverForLocation` it asks for BLUETOOTH_SCAN
        and BLUETOOTH_CONNECT and nothing else, which is what
        app/mobile/bluetooth.ts turns on.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
</manifest>
