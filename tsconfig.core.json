{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "baseUrl": ".",
    "paths": { "#core/*": ["./lib/*"] }
  },
  "include": ["lib/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  // test/nuxt/ holds the specs that import from app/, which this project
  // deliberately cannot see. Nuxt's generated tsconfig.app.json owns them.
  "exclude": ["test/nuxt/**"]
}
