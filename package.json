{
  "name": "boofwang",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Browser-based codeplug editor and programmer for the Quansheng UV-K5, Baofeng UV-5R Mini, and Baofeng DM-32UV",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebentern/boofwang.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "bridge": "node tools/serial-bridge/server.mjs",
    "bridge:ble": "python3 tools/ble-bridge/server.py",
    "build": "nuxt build && node scripts/build-service-worker.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "desktop:build": "pnpm desktop:site && node scripts/desktop-build.mjs",
    "desktop:dev": "pnpm desktop:site && electron .",
    "desktop:site": "NUXT_APP_BASE_URL=/ nuxt generate",
    "mobile:site": "pnpm desktop:site",
    "mobile:sync": "pnpm mobile:site && cap sync",
    "mobile:android": "pnpm mobile:sync && cap run android",
    "mobile:ios": "pnpm mobile:sync && cap run ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "dev": "nuxt dev",
    "generate": "nuxt generate && node scripts/build-service-worker.mjs",
    "icons": "node scripts/make-icons.mjs",
    "icons:check": "node scripts/make-icons.mjs --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@boofwang/usb-serial": "file:mobile/plugins/usb-serial",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^0.11.0",
    "@tanstack/vue-virtual": "^3.13.0",
    "@vueuse/nuxt": "^13.0.0",
    "idb": "^8.0.3",
    "nuxt": "^4.5.2",
    "pinia": "^3.0.0",
    "vue": "^3.5.41",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@iconify-json/lucide": "^1.2.123",
    "@nuxt/eslint": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.0",
    "electron": "33",
    "electron-builder": "25",
    "eslint": "^10.8.1",
    "fast-check": "^4.1.1",
    "serialport": "^13.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "ws": "^8.21.3"
  },
  "main": "electron/main.mjs"
}
